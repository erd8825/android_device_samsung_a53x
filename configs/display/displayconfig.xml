<displayConfiguration>
    <screenBrightnessMap>
        <point>
            <value>0.0</value>
            <nits>2</nits>
        </point>
        <point>
            <value>0.02</value>
            <nits>10.86</nits>
        </point>
        <point>
            <value>0.15</value>
            <nits>110</nits>
        </point>
        <point>
            <value>0.20</value>
            <nits>160</nits>
        </point>
        <point>
            <value>0.25</value>
            <nits>203</nits>
        </point>
        <point>
            <value>0.50</value>
            <nits>407</nits>
        </point>
        <point>
            <value>0.96</value>
            <nits>783.5</nits>
        </point>
        <point>
            <value>0.98</value>
            <nits>799.5</nits>
        </point>
        <point>
            <value>1.00</value>
            <nits>800</nits>
        </point>
    </screenBrightnessMap>

    <highBrightnessMode enabled="true">
        <transitionPoint>0.524691</transitionPoint>
        <minimumLux>3000</minimumLux>
        <timing>
            <timeWindowSecs>0</timeWindowSecs> // Window in which we restrict HBM.
            <timeMaxSecs>0</timeMaxSecs>       // Maximum time of HBM allowed in that window.
            <timeMinSecs>0</timeMinSecs>       // Minimum time remaining required to switch
        </timing>                              //   HBM on for.
    </highBrightnessMode>

    <autoBrightness enabled="true">
        <luxToBrightnessMapping>
            <mode>default</mode>
            <setting>normal</setting>
            <map>
                <point>
                    <first>0</first>
                    <second>0.0215</second> <!-- 12 nits -->
                </point>
                <point>
                    <first>1</first>
                    <second>0.0320</second> <!-- 20 nits -->
                </point>
                <point>
                    <first>2</first>
                    <second>0.0451</second> <!-- 30 nits -->
                </point>
                <point>
                    <first>5</first>
                    <second>0.0648</second> <!-- 45 nits -->
                </point>
                <point>
                    <first>10</first>
                    <second>0.0910</second> <!-- 65 nits -->
                </point>
                <point>
                    <first>20</first>
                    <second>0.1303</second> <!-- 95 nits -->
                </point>
                <point>
                    <first>50</first>
                    <second>0.1750</second> <!-- 135 nits -->
                </point>
                <point>
                    <first>100</first>
                    <second>0.2233</second> <!-- 180 nits -->
                </point>
                <point>
                    <first>200</first>
                    <second>0.3015</second> <!-- 245 nits -->
                </point>
                <point>
                    <first>400</first>
                    <second>0.3934</second> <!-- 320 nits -->
                </point>
                <point>
                    <first>800</first>
                    <second>0.5159</second> <!-- 420 nits -->
                </point>
                <point>
                    <first>1500</first>
                    <second>0.5220</second> <!-- 425 nits -->
                </point>
                <point>
                    <first>3000</first>
                    <second>0.7358</second> <!-- 600 nits -->
                </point>
                <point>
                    <first>6000</first>
                    <second>0.9191</second> <!-- 750 nits -->
                </point>
                <point>
                    <first>12000</first>
                    <second>1.0000</second> <!-- 800 nits -->
                </point>
                <point>
                    <first>25000</first>
                    <second>1.0000</second> <!-- 800 nits -->
                </point>
                <point>
                    <first>50000</first>
                    <second>1.0000</second> <!-- 800 nits -->
                </point>
                <point>
                    <first>100000</first>
                    <second>1.0000</second> <!-- 800 nits -->
                </point>
                <point>
                    <first>200000</first>
                    <second>1.0000</second> <!-- 800 nits -->
                </point>
            </map>
        </luxToBrightnessMapping>
        <brighteningLightDebounceMillis>300</brighteningLightDebounceMillis>
        <darkeningLightDebounceMillis>400</darkeningLightDebounceMillis>
        <brighteningLightDebounceIdleMillis>-1</brighteningLightDebounceIdleMillis>
        <darkeningLightDebounceIdleMillis>-1</darkeningLightDebounceIdleMillis>
    </autoBrightness>

    <hdrBrightnessConfig>
        <brightnessMap>
        </brightnessMap>
        <brightnessIncreaseDebounceMillis>0</brightnessIncreaseDebounceMillis>
        <screenBrightnessRampIncrease>-1.0</screenBrightnessRampIncrease>
        <brightnessDecreaseDebounceMillis>0</brightnessDecreaseDebounceMillis>
        <screenBrightnessRampDecrease>-1.0</screenBrightnessRampDecrease>
    </hdrBrightnessConfig>

    <lightSensor>
        <type>com.samsung.sensor.autobrightness</type>
        <name>TCS3701 Auto Brightness Sensor</name>
    </lightSensor>
</displayConfiguration>
