            <nits>10.7</nits>
        </point>
        <point>
            <value>0.0802</value>
            <nits>38.4</nits>
        </point>
        <point>
            <value>0.2263</value>
            <nits>142.1</nits>
        </point>
        <point>
            <value>0.4403</value>
            <nits>334.8</nits>
        </point>
        <point>
            <value>0.5103</value>
            <nits>405.1</nits>
        </point>
        <point>
            <value>0.5247</value>
            <nits>420</nits>
        </point>
        <point>
            <value>0.5267</value>
